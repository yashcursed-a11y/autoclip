{
  "name": "autoclip",
  "version": "2.0.0",
  "description": "AUTOCLIPIN - Personal long-form video clipping studio",
  "main": "electron-main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/yashcursed-a11y/autoclip.git"
  },
  "scripts": {
    "start": "electron electron-main.js",
    "app": "electron electron-main.js",
    "build:exe": "electron-builder --win",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -mwl",
    "server": "node --max-old-space-size=512 server.js",
    "check": "node --check server.js && node --check public/app.js && node --check electron-main.js",
    "test": "node test/e2e.test.js",
    "build:website": "npm --prefix website run build",
    "sync:website": "node scripts/sync-website.cjs"
  },
  "build": {
    "appId": "com.autoclip.pro",
    "productName": "AUTOCLIPIN",
    "publish": [
      {
        "provider": "github",
        "owner": "yashcursed-a11y",
        "repo": "autoclip"
      }
    ],
    "asarUnpack": [
      "scripts/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "hardenedRuntime": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AUTOCLIPIN"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!work/**",
      "!website/**",
      "!.github/**",
      "!public/downloads/**"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "googleapis": "^189.0.0",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  }
}
